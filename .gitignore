# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment (kept on E: — C: has only ~18 GB free)
.venv/
venv/
.venv-export/   # throwaway env for scripts/export_yolo.ps1

# Environment / secrets
.env
*.local.env

# Databases and logs
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
logs/
*.log

# Model weights — cached outside the repo (see docs/setup_windows.md, spec §45)
#
# NOT a bare `models/` rule. That was here, and it silently excluded
# backend/focusguard_backend/models/ - the entire SQLAlchemy package - so a
# clone of the Phase 12 commit could not import the backend at all. Weights live
# in the cache dir outside the repo anyway, and the extension patterns below
# catch any that stray in, so the directory rule bought nothing.
*.onnx
*.task
*.pt
*.tflite

# Frontend
node_modules/
dist/
.vite/

# Local toolchain. Node lives here because E:iles (where it was first
# unpacked) is not writable by this account, and that incomplete extraction is
# why npm was missing its module tree. ~80 MB of binaries; never committed.
.tools/

# Captured media must never be committed (spec §34)
*.mp4
*.avi
captures/
screenshots/

# OS / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# Backend development databases
backend/*.db
backend/*.db-shm
backend/*.db-wal

# Emails saved instead of sent when no SMTP server is configured
dev_outbox/
