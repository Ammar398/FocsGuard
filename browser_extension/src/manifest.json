{
  "manifest_version": 3,
  "name": "FocusGuard",
  "version": "0.2.0",
  "key": "",
  "description": "Tells FocusGuard on this computer which website your active tab is on (the domain only, never the full address).",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusGuard monitoring status"
  },
  "icons": {
    "128": "icon128.png"
  }
}
