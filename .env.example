# FocusGuard environment configuration
#
# Copy this file to `.env` and edit as needed. `.env` is gitignored; never commit
# real secrets. Every value here has a working default in
# desktop_agent/focusguard_agent/config.py - this file only documents the knobs
# and shows the naming convention.
#
# Naming: FOCUSGUARD_<SECTION>__<FIELD>, using a DOUBLE underscore for nesting.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
FOCUSGUARD_LOG_LEVEL=INFO
FOCUSGUARD_DEBUG_OVERLAY=false

# Overrides where models, logs and the local event queue are stored.
# Defaults to %LOCALAPPDATA%\FocusGuard
# FOCUSGUARD_DATA_DIR=E:\focusguard-data

# Force an inference provider instead of auto-detecting. Mainly used to verify
# that the CPU fallback still works on a machine that has a GPU.
# One of: CUDAExecutionProvider | DmlExecutionProvider | CPUExecutionProvider
# FOCUSGUARD_FORCE_PROVIDER=CPUExecutionProvider

# ---------------------------------------------------------------------------
# Camera
# ---------------------------------------------------------------------------
# Cameras are matched BY NAME first, because virtual camera indices shift as
# their host application starts and stops. This machine has no physical webcam;
# available devices are "Camo", "DroidCam Video" and "Pixel 7 (Windows Virtual Camera)".
# Leave unset to choose automatically: a real webcam first, Camo/DroidCam only
# when there is none. Set part of a camera's name to always use that one.
# FOCUSGUARD_CAMERA__DEVICE_NAME=Camo
FOCUSGUARD_CAMERA__DEVICE_INDEX=0
FOCUSGUARD_CAMERA__BACKEND=dshow

# Phone cameras deliver 1080p+ by default; forcing a small frame protects the CPU.
FOCUSGUARD_CAMERA__FRAME_WIDTH=640
FOCUSGUARD_CAMERA__FRAME_HEIGHT=480
FOCUSGUARD_CAMERA__TARGET_FPS=25

# Set these if your phone is mounted rotated or the image appears mirrored.
FOCUSGUARD_CAMERA__ROTATE_DEGREES=0
FOCUSGUARD_CAMERA__FLIP_HORIZONTAL=false

# ---------------------------------------------------------------------------
# Vision thresholds
# ---------------------------------------------------------------------------
FOCUSGUARD_VISION__LANDMARK_FPS=12
FOCUSGUARD_VISION__PHONE_DETECTION_FPS=3

# Grace periods, in seconds. A brief glance away must never cost points.
FOCUSGUARD_VISION__FACE_ABSENT_GRACE_SECONDS=2.0
FOCUSGUARD_VISION__GAZE_AWAY_GRACE_SECONDS=4.0
FOCUSGUARD_VISION__EYES_CLOSED_GRACE_SECONDS=1.0
FOCUSGUARD_VISION__DROWSY_DURATION_SECONDS=2.5
FOCUSGUARD_VISION__PHONE_GRACE_SECONDS=1.5

# Fallback only. A personal threshold from calibration is preferred.
FOCUSGUARD_VISION__DEFAULT_EAR_THRESHOLD=0.21
FOCUSGUARD_VISION__PHONE_CONFIDENCE_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------
# SINGLE | DUAL | MULTI - with a second screen, looking away from the webcam is
# often still work, so the gaze-away penalty is reduced.
FOCUSGUARD_SCORING__MONITOR_PROFILE=SINGLE

# Falling faster than it recovers is what keeps the score from oscillating.
FOCUSGUARD_SCORING__SMOOTHING_ALPHA_DOWN=0.15
FOCUSGUARD_SCORING__SMOOTHING_ALPHA_UP=0.04

FOCUSGUARD_SCORING__VISUAL_ATTENTION_WEIGHT=0.5
FOCUSGUARD_SCORING__DIGITAL_PRODUCTIVITY_WEIGHT=0.5

# ---------------------------------------------------------------------------
# Activity and website monitoring
# ---------------------------------------------------------------------------
FOCUSGUARD_ACTIVITY__POLL_INTERVAL_SECONDS=1.0

# Window titles can leak document and file names, so they are OFF by default.
FOCUSGUARD_ACTIVITY__COLLECT_WINDOW_TITLES=false

# Loopback endpoint the browser extension posts to. Must stay on 127.0.0.1.
FOCUSGUARD_ACTIVITY__IPC_HOST=127.0.0.1
FOCUSGUARD_ACTIVITY__IPC_PORT=48213

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Writes preview frames to disk. Debugging only - never enable in normal use.
FOCUSGUARD_PRIVACY__STORE_WEBCAM_FRAMES=false
FOCUSGUARD_PRIVACY__REQUIRE_CONSENT_BEFORE_MONITORING=true
FOCUSGUARD_PRIVACY__SHOW_MONITORING_INDICATOR=true
FOCUSGUARD_PRIVACY__RAW_EVENT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Backend sync. An unenrolled computer uploads nothing regardless.
# ---------------------------------------------------------------------------
FOCUSGUARD_SYNC__ENABLED=true
FOCUSGUARD_SYNC__BACKEND_URL=http://127.0.0.1:8000
FOCUSGUARD_SYNC__BATCH_SIZE=50
FOCUSGUARD_SYNC__UPLOAD_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# FocusGuard Helper: one-click "Connect this computer" / "Start session" from
# the portal. Loopback only. Add your deployed portal's origin to the list.
# ---------------------------------------------------------------------------
FOCUSGUARD_HELPER__PORT=48214
# FOCUSGUARD_HELPER__ALLOWED_ORIGINS=["http://localhost:5173","https://focusguard.example.com"]

# ---------------------------------------------------------------------------
# Backend server (Phase 12+)
# ---------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./focusguard.db
# JWT_SECRET_KEY=change-me-to-a-long-random-value
# JWT_ACCESS_TOKEN_MINUTES=15

# ---------------------------------------------------------------------------
# Email: sign-up verification codes and password-reset codes.
# Without FOCUSGUARD_SMTP_HOST, emails are NOT sent - each one is saved as a
# .eml file in FOCUSGUARD_DEV_OUTBOX (double-click to open it).
# Gmail: smtp.gmail.com, port 587, your address, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# ---------------------------------------------------------------------------
# FOCUSGUARD_SMTP_HOST=smtp.gmail.com
# FOCUSGUARD_SMTP_PORT=587
# FOCUSGUARD_SMTP_USERNAME=you@gmail.com
# FOCUSGUARD_SMTP_PASSWORD=your-16-character-app-password
# FOCUSGUARD_MAIL_FROM=FocusGuard <you@gmail.com>
FOCUSGUARD_DEV_OUTBOX=dev_outbox
# Set to 0 only for a demo with no email at all: sign-ups then skip the code.
FOCUSGUARD_REQUIRE_EMAIL_VERIFICATION=1
